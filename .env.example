# Kakao Maps Javascript key (public, domain-restricted; NOT a secret)
VITE_KAKAO_JS_KEY=
# Deployed Cloudflare Worker URL (holds Kakao REST key as a server-side secret)
VITE_ROUTE_PROXY_URL=
# Optional repository path when using a project GitHub Pages site (e.g. /saturday-golf-day/)
# BASE_PATH=/saturday-golf-day/
